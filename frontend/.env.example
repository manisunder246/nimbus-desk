# For local dev keep API base pointing at the local Express server.
# In production builds, infrastructure/09-deploy.sh injects the EC2 DNS.
VITE_API_BASE_URL=http://localhost:3001/api
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_REGION=ap-south-1
