# Tests symlink this to ../.env.infrastructure during normal use:
#   ln -sf ../.env.infrastructure tests/.env
# If you'd rather populate explicitly, copy this file to tests/.env.
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=ap-south-1
DYNAMODB_TICKETS_TABLE=nimbusdesk-tickets
S3_ATTACHMENTS_BUCKET=nimbusdesk-attachments-XXXXXXXXXXXX
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:ap-south-1:XXXXXXXXXXXX:nimbusdesk-notifications
