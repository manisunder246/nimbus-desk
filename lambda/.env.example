# The Lambda picks env vars up from its function configuration, not a file.
# This sample documents what infrastructure/06-lambda.sh injects via
# `--environment Variables=...` so you know what the function reads.
TICKETS_TABLE=nimbusdesk-tickets
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:XXXXXXXXXXXX:nimbusdesk-notifications

# Note: the AWS Lambda runtime reserves the AWS_REGION env name.
# We pass region via AWS_REGION_NAME instead.
AWS_REGION_NAME=ap-south-1
