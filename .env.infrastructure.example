# ============================================================
# NimbusDesk root infrastructure manifest — copy to
#   .env.infrastructure
# and fill in values produced by infrastructure/0[1-8]-*.sh.
# ============================================================

# Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=ap-south-1

# DynamoDB
DYNAMODB_TICKETS_TABLE=nimbusdesk-tickets
DYNAMODB_USERS_TABLE=nimbusdesk-users

# S3 (account-id suffix to keep bucket name globally unique)
S3_ATTACHMENTS_BUCKET=nimbusdesk-attachments-XXXXXXXXXXXX

# SNS
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:ap-south-1:XXXXXXXXXXXX:nimbusdesk-notifications
SNS_SUBSCRIBE_EMAIL=your-email@example.com

# IAM
IAM_EC2_ROLE_NAME=nimbusdesk-ec2-role
IAM_EC2_ROLE_ARN=arn:aws:iam::XXXXXXXXXXXX:role/nimbusdesk-ec2-role
IAM_EC2_INSTANCE_PROFILE=nimbusdesk-ec2-instance-profile
IAM_LAMBDA_ROLE_ARN=arn:aws:iam::XXXXXXXXXXXX:role/nimbusdesk-lambda-role

# Lambda
LAMBDA_CLASSIFIER_NAME=nimbusdesk-classifier
LAMBDA_CLASSIFIER_ARN=arn:aws:lambda:ap-south-1:XXXXXXXXXXXX:function:nimbusdesk-classifier

# API Gateway
APIGW_REST_API_ID=XXXXXXXXXX
APIGW_CLASSIFIER_URL=https://XXXXXXXXXX.execute-api.ap-south-1.amazonaws.com/prod/classify

# EC2
EC2_SECURITY_GROUP_ID=sg-XXXXXXXXXXXXXXXXX
EC2_KEY_PAIR_NAME=nimbusdesk-key
EC2_INSTANCE_ID=i-XXXXXXXXXXXXXXXXX
EC2_PUBLIC_DNS=ec2-XX-XX-XX-XX.ap-south-1.compute.amazonaws.com
EC2_PUBLIC_IP=XX.XX.XX.XX

# Cognito analyst seed (created by infrastructure scripts; quote the
# password because dotenv treats `#` as a comment marker)
COGNITO_ANALYST_EMAIL=your-analyst@example.com
COGNITO_ANALYST_PASSWORD='ChangeMe#2026!'
